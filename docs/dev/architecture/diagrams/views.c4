views {

  view index {
    title 'L1 · System context'
    description 'Who uses SchellingBoard and what it talks to.'
    include *
    exclude reverseProxy
    autoLayout TopBottom
  }

  view containers of sb {
    title 'L2 · Containers'
    description 'One process, one static bundle, one database file.'
    include *, attendee, smtp, pushService
    autoLayout LeftRight
  }

  view server of sb.server {
    title 'L3 · Server: infrastructure components and modules'
    description 'HTTP, feed and jobs are the drivers. Modules hold the business rules. The kernel is the only shared code.'
    include *, sb.db, sb.files
    autoLayout TopBottom
  }

  view modules of sb.server {
    title 'L3 · Server: modules'
    description 'Modules hold the business rules and import each other only through module.ts; meetings reads events. Notifications are created by the jobs loop reacting to recorded changes.'
    include sb.server.mEvents, sb.server.mVenue, sb.server.mPeople, sb.server.mProposals,
            sb.server.mSessions, sb.server.mComments, sb.server.mMeetings,
            sb.server.mNotifications, sb.server.mSettings, sb.server.mUpdates
    autoLayout BottomTop
  }

  view web of sb.web {
    title 'L3 · Web app components'
    description 'Everything renders from the replica. Commands are the only writers.'
    include *, sb.server.http, sb.server.feed
    autoLayout TopBottom
  }

  dynamic view flowRsvp {
    title 'Flow · RSVP with optimistic update and live propagation'
    attendee -> sb.web.features 'taps RSVP on a session'
    sb.web.features -> sb.web.commands 'rsvp(sessionId)'
    sb.web.commands -> sb.web.replica 'apply predicted change (policy says allowed, capacity not exceeded)'
    sb.web.commands -> sb.server.http 'PUT /sessions/{id}/rsvps/{guestId} (Idempotency-Key)'
    sb.server.http -> sb.server.mSessions 'rsvp use case: check phase and capacity, write, record change'
    sb.server.mSessions -> sb.server.kernel 'commit state + change in one transaction'
    sb.server.kernel -> sb.server.feed 'publish change seq N'
    sb.server.feed -> sb.web.replica 'change seq N to every viewer of the event (this one matches it to the prediction by command_key)'
    sb.server.http -> sb.web.commands 'the result, with the recorded change'
  }

  dynamic view flowSessionChanged {
    title 'Flow · Site admin edits a session; attendees are told'
    siteAdmin -> sb.server.http 'PUT /sessions/{id}'
    sb.server.http -> sb.server.mSessions 'update use case: clash check'
    sb.server.mSessions -> sb.server.kernel 'record session.changed'
    sb.server.kernel -> sb.server.feed 'publish to the event audience'
    sb.server.jobs -> sb.server.mNotifications "reaction: session.changed -> notifications for hosts and RSVP'd attendees"
    sb.server.jobs -> smtp 'delivery: email'
    sb.server.jobs -> pushService 'delivery: push'
  }

  dynamic view flowJoin {
    title 'Flow · First login through a personal join link'
    attendee -> sb.web.shell 'opens /join/{token} from email'
    sb.web.shell -> sb.server.http 'POST /auth/join {token}'
    sb.server.http -> sb.server.mPeople 'validate token, create a verified login session'
    sb.server.http -> sb.web.shell 'Set-Cookie (httpOnly, SameSite=Lax) + actor context'
    sb.web.shell -> sb.web.replica 'load event'
    sb.web.replica -> sb.server.feed 'GET snapshot, then subscribe since seq'
  }

  dynamic view flowReconnect {
    title 'Flow · Back online after a wifi drop'
    sb.web.pwa -> sb.web.shell 'app opened offline: shell from precache'
    sb.web.shell -> sb.web.replica 'load persisted replica (seq 4120), show "last synced 14:02"'
    sb.web.replica -> sb.server.feed 'GET feed?since=4120'
    sb.server.feed -> sb.web.replica 'changes 4121..4187, or a reset message if pruned → full snapshot'
    sb.web.replica -> sb.web.features 're-render, banner disappears'
  }
}
